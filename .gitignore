# ============================================================
# 课程作品集通用 .gitignore
# 作用：告诉 Git 哪些文件"不用管、不上传"
# ============================================================

# ---------- 操作系统垃圾文件 ----------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
# macOS
.DS_Store
.AppleDouble
.LSOverride
# Linux
*~
.fuse_hidden*
.directory

# ---------- 编辑器 / IDE ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/

# ---------- Node.js ----------
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- 数据与大文件（中间产物不入库）----------
*.log
*.tmp
*.temp
*.bak
data/raw/
data/temp/
output/
build/
dist/
*.zip
*.rar
*.7z

# ---------- 环境变量与密钥（绝不上传）----------
.env
.env.*
*.pem
*.key
secrets.*

# ---------- Office / WPS 临时文件 ----------
~$*.docx
~$*.xlsx
~$*.pptx

# ---------- MATLAB / R ----------
*.asv
.Rhistory
.RData
.Rproj.user/
